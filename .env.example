# Supabase Project URL - Get this from your Supabase project settings > API
# Example: https://xyzcompany.supabase.co
VITE_SUPABASE_URL=your_supabase_url_here

# Supabase Anonymous (Public) Key - Get this from your Supabase project settings > API > anon/public key
# This key is safe to use in the browser as RLS policies protect your data
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# WhatsApp Business Number - The phone number orders will be sent to via WhatsApp
# Format: country code + number without + or spaces (e.g., 919999999999 for India)
VITE_WHATSAPP_NUMBER=919999999999
